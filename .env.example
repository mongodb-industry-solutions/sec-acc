# Optional. Copy to `.env` at the repository root (never per project). Runtime variables win over this file.
# Names and safe placeholders only. Never commit real values.

# MongoDB target. The product is never inferred from the URI.
MONGODB_TYPE=atlas        # atlas | ea | ce
MONGODB_VERSION=9.0.0
MONGODB_URI=              # secret, required by backend services, setup and seed
MONGODB_DB=acc            # optional

# Backend service selection and binding (server.ts)
ACC_SERVICE=policy        # policy | decision | mgf | audit
HOST=127.0.0.1
# PORT=                   # optional, each service has a default

# GIAM issuer (pending contract, see docs/architecture/giam-integration.md)
# GIAM_ISSUER_URL=https://<authority>/api/v1/realms/<realm>
